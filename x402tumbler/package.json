{
  "name": "DarkCircle",
  "version": "1.0.0",
  "description": "Enterprise-grade x402 payment privacy engine for Quai Network (WQUAI / WQI): shielded-pool settlement, ephemeral payees and PPOI compliance",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "darkcircle": "./bin/darkcircle.ts"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "cli": "node bin/darkcircle.ts",
    "relayer": "node bin/relayer.ts",
    "relayer:key": "node scripts/relayer-key.ts",
    "rehearsal:orchard": "node scripts/relayer-rehearsal.ts full",
    "verify:quai": "node scripts/verify-quai.ts",
    "ui": "node scripts/serve-ui.ts",
    "voice:setup": "python scripts/whisper_setup.py",
    "test": "node --test test/unit/*.test.ts test/e2e/*.test.ts test/adversarial/*.test.ts test/admin/*.test.ts",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:e2e": "node --test test/e2e/*.test.ts",
    "test:adversarial": "node --test test/adversarial/*.test.ts",
    "test:admin": "node --test test/admin/*.test.ts",
    "redact:admin": "node scripts/redact-admin.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "ethers": "^6.13.5",
    "poseidon-lite": "^0.3.0"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@types/node": "^24.11.1",
    "circom2": "^0.2.23",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "ffjavascript": "^0.3.1",
    "snarkjs": "^0.7.6",
    "solc": "0.8.37",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10"
  }
}
