{
  "name": "@darkorder/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DarkOrder contracts for Quai Cyprus-1: guild core, token voting, council multisig, name registry and the founding factory.",
  "scripts": {
    "build": "hardhat compile",
    "compile": "hardhat compile",
    "test": "hardhat test test/Guild.test.ts test/MajorityVoting.test.ts test/CouncilMultisig.test.ts test/GuildFactory.test.ts",
    "test:forge": "forge test",
    "test:forge:deep": "forge test --profile deep",
    "lint": "tsc --noEmit",
    "lint:forge": "forge lint --deny warnings",
    "lint:slither": "slither . --compile-force-framework hardhat --filter-paths \"node_modules|contracts/test|lib/|test/\" --fail-medium",
    "clean": "hardhat clean",
    "deploy:testnet": "node scripts/deploy-quai.mjs --network orchard",
    "deploy:mainnet": "node scripts/deploy-quai.mjs --network mainnet",
    "keystore:new": "node scripts/keystore-new.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.2.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "chai": "^4.5.0",
    "ethers": "6.17.0",
    "hardhat": "^2.22.18",
    "quais": "1.0.0-alpha.57",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
