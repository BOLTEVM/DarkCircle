{
  "name": "@darksafe/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Quai Cyprus-1 multi-signature vault contracts for DarkSafe (v2)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "hardhat compile && pnpm typechain",
    "compile": "hardhat compile && pnpm typechain",
    "typechain": "typechain --target ethers-v6 --out-dir typechain-types \"artifacts/contracts/**/!(*.dbg).json\"",
    "test": "hardhat test test/v2/DarkSafeVault.test.ts test/v2/DarkSafeVault.fuzz.test.ts test/v2/core-integration.test.ts test/v2/tools-integration.test.ts",
    "coverage": "hardhat coverage --testfiles \"test/v2/DarkSafeVault*.test.ts\"",
    "coverage:check": "hardhat coverage --testfiles \"test/v2/DarkSafeVault*.test.ts\" && node scripts/check-coverage.js",
    "opcode:check": "node scripts/check-opcodes.js",
    "pin": "node scripts/pin-bytecode.js",
    "pin:check": "node scripts/pin-bytecode.js --check",
    "deploy:testnet": "node scripts/deploy-v2.mjs --network orchard",
    "deploy:mainnet": "node scripts/deploy-v2.mjs --network mainnet",
    "clean": "hardhat clean",
    "lint": "tsc --noEmit",
    "forge:test": "forge test",
    "forge:deep": "forge test --profile deep",
    "forge:diff": "forge test --profile differential",
    "forge:lint": "forge lint --deny warnings --report-unused-suppressions",
    "forge:snapshot": "forge snapshot --match-path test/foundry/Gas.t.sol",
    "forge:snapshot:check": "forge snapshot --match-path test/foundry/Gas.t.sol --check",
    "slither": "slither . --config-file slither.config.json",
    "keystore:new": "node scripts/new-keystore.mjs",
    "local-chain": "node scripts/local-quai-chain.mjs",
    "soak:local": "node scripts/soak-v2.mjs --network local",
    "soak:testnet": "node scripts/soak-v2.mjs --network orchard",
    "verification:export": "node scripts/export-verification.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.2.0",
    "@darksafe/core": "workspace:*",
    "@darksafe/verify": "workspace:*",
    "@darksafe/watcher": "workspace:*",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "chai": "^4.5.0",
    "ethers": "6.17.0",
    "hardhat": "^2.22.18",
    "quais": "1.0.0-alpha.57",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.7.3"
  }
}
