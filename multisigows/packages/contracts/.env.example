# Quai Cyprus-1 RPC endpoints (defaults in hardhat.config.cjs are used if unset)
QUAI_ORCHARD_RPC_URL=https://orchard.rpc.quai.network/cyprus1
QUAI_MAINNET_RPC_URL=https://rpc.quai.network/cyprus1

# Deployer private key for a Cyprus-1 (0x00-prefixed) account. NEVER commit a real
# funded key. hardhat.config.cjs deploys with no accounts configured if unset.
CYPRUS1_PRIVATE_KEY=
