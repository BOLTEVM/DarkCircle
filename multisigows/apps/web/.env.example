# Which Quai network profile the dashboard targets: "testnet" (Orchard, chain id 15000)
# or "mainnet" (Cyprus-1, chain id 9). Defaults to "testnet" if unset.
VITE_QUAI_NETWORK=testnet

# Optional: override the profile's canonical RPC endpoint, e.g. to point at a private
# or dedicated Cyprus-1 node instead of the public gateway. If you set this, also add the
# node's origin to connect-src in vercel.json and nginx.conf.example, or the browser will
# block every RPC call.
# VITE_QUAI_RPC_URL=https://orchard.rpc.quai.network/cyprus1

# Mainnet vault creation stays OFF until the vault contract has had an independent audit.
# Only set this in a build you control and after accepting that risk.
# VITE_ALLOW_MAINNET_VAULTS=true

# Confirmations to wait for before treating a transaction as final (1-100).
# Defaults: 3 on mainnet, 6 on Orchard (which has had 25-block reorgs).
# VITE_TX_CONFIRMATIONS=6

# Optional: use this SafeBuddy v2 factory instead of the recorded deployment. The app checks
# its code, implementation and proxy against the pinned build before trusting it.
# VITE_V2_FACTORY_ADDRESS=0x00...

# Optional: a second, independent RPC. Vault state and transaction contents are compared
# across sources (plus your wallet's node) and any disagreement blocks writes. Add its
# origin to connect-src in vercel.json and nginx.conf.example.
# VITE_QUAI_SECONDARY_RPC_URL=https://...
